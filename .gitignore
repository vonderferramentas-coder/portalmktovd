# Ferramentas locais (Claude Code / agentes) — não faz parte do site
.agents/
.claude/
.autosync/

# Lixo do Windows
Thumbs.db
desktop.ini

# Biblioteca local de logos-fonte (EPS/SVG brutos, ~2GB, não usada pelo site em produção)
post-editor-assets/brands/

# Temporários e dados locais que não devem ir pro repositório
tmp/
*.sqlite
*.sqlite-journal
*.db

# Exports pessoais do Instagram ("Baixe suas informações") usados como fonte pontual para
# reconstruir histórico — contêm dado pessoal (username/link) de cada seguidor e não devem
# ir pro repositório; só o resultado já agregado em data/social-followers-*.json é publicado.
data/instagram-*-20*/

# Segredos — nunca commitar
.env
.env.*
*.key
*.pem
