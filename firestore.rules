rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return authenticated() && currentUser().status == 'active';
    }

    function admin() {
      return activeUser() && currentUser().role == 'admin';
    }

    // Documentos de controle (quem pode ver o quê, pra onde notificações vão) - ninguém edita
    // isso direto na tela, sempre passa por uma ação administrativa. Sem essa checagem, um
    // usuário comum conseguiria se autopromover a admin escrevendo direto nesses documentos
    // pelo console do navegador (a tela de Usuários e acessos só bloqueia pela interface).
    function isControlDoc(id) {
      return id in ['user-profiles-v1', 'page-permissions-v1', 'social-media-notification-routes-v1'];
    }
    // Seguidores/posts/vídeos/trends: só o GitHub Actions grava isso (Admin SDK, que ignora
    // estas regras por definição) - nenhum caminho legítimo de escrita pelo navegador. Travar
    // pra admin não tira função de ninguém e evita que um usuário comum forje esses números.
    function isCollectedDataDoc(id) {
      return id.matches('^(followers|posts|youtube-videos|youtube-mentions|facebook-posts|trends|art-stats)-.*');
    }

    match /users/{userId} {
      allow get: if authenticated() && (request.auth.uid == userId || admin());
      allow list: if admin();
      allow create, delete: if admin();
      // lastAccessAt (auth-guard.js, todo login) e name/photo (menu "Perfil", autoatendimento) são
      // os únicos campos que o próprio dono da conta pode alterar sem ser admin - role/status/email
      // continuam travados, então ninguém se autopromove escrevendo direto pelo console.
      allow update: if admin() || (request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAccessAt', 'name', 'photo']));
    }

    match /securityAudit/{eventId} {
      allow read: if admin();
      allow create: if activeUser() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Eventos são criados pelo navegador do próprio colaborador somente após uma entrega
    // concluída. Ele nunca pode ler, editar ou excluir o histórico. Os resumos são produzidos
    // pelo GitHub Actions/Admin SDK; Gestão recebe só os agregados, Admin também o detalhe.
    match /usageEvents/{eventId} {
      allow create: if activeUser()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['actorUid', 'tool', 'action', 'brandId', 'quantity', 'createdAt'])
        && request.resource.data.tool is string
        && request.resource.data.action is string
        && request.resource.data.brandId is string
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 10000;
      allow read: if admin();
      allow update, delete: if false;
    }

    match /usageDaily/{summaryId} {
      allow read: if activeUser() && (currentUser().role == 'admin' || currentUser().role == 'gestao');
      allow write: if false;
    }

    // Páginas públicas /redir/<marca>/<pasta>/index.html (QR rastreável) criam um registro por
    // escaneamento, sem login. Só esses campos mínimos (sem IP, sem cookie); só quem está logado lê.
    match /qrHits/{hitId} {
      allow create: if request.resource.data.keys().hasOnly(['qr', 't', 'os', 'lang', 'test'])
        && request.resource.data.keys().hasAll(['qr', 't', 'os', 'lang', 'test'])
        && request.resource.data.qr is string && request.resource.data.qr.size() <= 80
        && request.resource.data.t is timestamp
        && request.resource.data.os in ['ios', 'android', 'outro']
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 10
        && request.resource.data.test is bool;
      allow read: if activeUser();
      allow update, delete: if false;
    }

    // Fotos das artes salvas do Editor de Posts: 1 documento por foto (id = hash SHA-256 truncado do arquivo original), JPEG já comprimido
    // no navegador (até ~350 KB; o teto aqui é o limite do documento). Qualquer usuário ativo lê e cria; ninguém altera nem apaga pelo
    // navegador, só a limpeza diária do GitHub Actions (Admin SDK). Fica de propósito fora do portalStore para não entrar no backup diário.
    match /artPhotos/{hash} {
      allow read: if activeUser();
      allow create: if activeUser()
        && hash.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['hash', 'data', 'size', 'w', 'h', 'type', 'createdAt', 'createdBy'])
        && request.resource.data.hash == hash
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.data is bytes && request.resource.data.data.size() <= 700000
        && request.resource.data.size is int && request.resource.data.size <= 700000
        && request.resource.data.type in ['image/jpeg', 'image/webp'];
      allow update, delete: if false;
    }

    match /portalStore/{recordId} {
      allow read: if activeUser();
      allow write: if activeUser() && (admin() || (!isControlDoc(recordId) && !isCollectedDataDoc(recordId)));
    }
  }
}
