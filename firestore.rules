rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return authenticated() && currentUser().status == 'active';
    }

    function admin() {
      return activeUser() && currentUser().role == 'admin';
    }

    match /users/{userId} {
      allow get: if authenticated() && (request.auth.uid == userId || admin());
      allow list: if admin();
      allow create, delete: if admin();
      allow update: if admin() || (request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAccessAt']));
    }

    match /securityAudit/{eventId} {
      allow read: if admin();
      allow create: if activeUser() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /portalStore/{recordId} {
      allow read, write: if activeUser();
    }
  }
}
